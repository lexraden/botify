# Telegram
HUB_BOT_TOKEN=1234567890:AAA...            # токен hub-бота (нового, от @BotFather)
WEBHOOK_BASE_URL=https://your-app.up.railway.app   # публичный HTTPS-адрес бэкенда; пусто = вебхуки не регистрируются (локальная разработка)
TELEGRAM_WEBHOOK_SECRET=change-me          # secret_token для проверки X-Telegram-Bot-Api-Secret-Token

# База данных
DATABASE_URL=postgresql+asyncpg://botify:botify@localhost:5432/botify

# Crypto Pay (@CryptoBot -> Crypto Pay -> My Apps; включить Security -> Transfers)
CRYPTO_PAY_TOKEN=

# Шифрование токенов seller-ботов (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_TOKEN_ENCRYPTION_KEY=

# Mini App
WEBAPP_URL=                                # URL витрины (Vue), пусто = кнопка Mini App не показывается

# Платформа
ADMIN_TELEGRAM_IDS=123456789               # через запятую
PLATFORM_COMMISSION_PCT=5

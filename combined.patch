From 500fddaf907c4a5a3a76b111cf016290513ca988 Mon Sep 17 00:00:00 2001
From: Free Agent <freeagent@hermes.local>
Date: Thu, 24 Sep 2026 00:09:27 +0000
Subject: [PATCH 2/3] freeagent: add scripts/check_env.py to validate .env
 against .env.example (botify)

---
 scripts/check_env.py | 56 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)
 create mode 100755 scripts/check_env.py

diff --git a/scripts/check_env.py b/scripts/check_env.py
new file mode 100755
index 0000000..c661f16
--- /dev/null
+++ b/scripts/check_env.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Check that .env contains all non-comment variables from .env.example."""
+
+import os
+import sys
+
+def load_example(path):
+    """Return set of variable names from .env.example (ignoring comments and blank lines)."""
+    vars_set = set()
+    with open(path, 'r', encoding='utf-8') as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith('#'):
+                continue
+            # handle inline comments? simple split on first '#'
+            if '#' in line:
+                line = line.split('#', 1)[0].strip()
+            if '=' in line:
+                var = line.split('=', 1)[0].strip()
+                vars_set.add(var)
+    return vars_set
+
+def load_env(path):
+    """Return set of variable names from .env (if exists)."""
+    if not os.path.isfile(path):
+        return set()
+    vars_set = set()
+    with open(path, 'r', encoding='utf-8') as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith('#'):
+                continue
+            if '#' in line:
+                line = line.split('#', 1)[0].strip()
+            if '=' in line:
+                var = line.split('=', 1)[0].strip()
+                vars_set.add(var)
+    return vars_set
+
+def main():
+    example_path = os.path.join(os.path.dirname(__file__), '..', 'backend', '.env.example')
+    env_path = os.path.join(os.path.dirname(__file__), '..', '.env')
+    example_vars = load_example(example_path)
+    env_vars = load_env(env_path)
+    missing = example_vars - env_vars
+    if missing:
+        print("Missing environment variables in .env:")
+        for var in sorted(missing):
+            print(f"  {var}")
+        sys.exit(1)
+    else:
+        print("All environment variables from .env.example are present in .env.")
+        sys.exit(0)
+
+if __name__ == '__main__':
+    main()
\ No newline at end of file
